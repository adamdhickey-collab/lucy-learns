# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it carries key names only and never a value.
#
# The image pipeline reads this one variable and no other. Supply it with
# --env-file rather than exporting it, which keeps it out of shell history and
# off the process command line:
#
#     node --env-file=.env.local scripts/pilot.mjs generate <scene> --yes
#
# `plan` and `approve` need nothing from here — plan reads no environment
# variables at all, and approve only moves files that already exist.

OPENAI_API_KEY=
